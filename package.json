{
  "name": "cc-kit",
  "version": "0.1.0",
  "description": "Claude Code Kit — bootstrap, install, and validate Claude Code skills, hooks, and CLAUDE.md",
  "type": "module",
  "bin": {
    "cc-kit": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "packs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "cc-kit contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jecketyuan-ux/cc-kit.git"
  },
  "bugs": {
    "url": "https://github.com/jecketyuan-ux/cc-kit/issues"
  },
  "homepage": "https://github.com/jecketyuan-ux/cc-kit#readme",
  "keywords": [
    "claude-code",
    "claude",
    "skills",
    "hooks",
    "cli",
    "agent-skills"
  ],
  "dependencies": {
    "commander": "^13.1.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
